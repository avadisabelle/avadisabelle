# The Sanctuaire Agentique — root commons — environment
#
# Copy to `.env.local` for local dev, and set these in the Vercel project settings
# for production. NEVER commit real values.

# Secret used to sign the ceremony token (the cookie proving a key was offered).
# Use a long, random string (e.g. `openssl rand -base64 48`).
CEREMONY_SIGNING_SECRET=change-me-to-a-long-random-secret

# The keys a guest may offer at the threshold, comma-separated.
# v1 stores them here in plaintext; harden later by storing SHA-256 hashes.
# Example: two invitation keys.
CEREMONY_KEYS=first-light,two-vessels-one-river

# How long a ceremony token stays valid, in hours (optional; default 168 = 7 days).
CEREMONY_TTL_HOURS=168
